# Medo AI Career Intelligence — Environment Configuration Template
# Copy to .env and replace placeholder values. NEVER commit .env with real secrets.

# --- Application ---
APP_NAME=Medo AI Career Intelligence
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security & Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-strong-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_BYTES=10485760

# --- Database (PostgreSQL + pgvector recommended; SQLite supported for local dev) ---
# Production/Docker PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://nexus:nexus_password@localhost:5432/nexus_ai
DATABASE_URL=sqlite:///./data/nexus_dev.db

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Document Storage ---
STORAGE_ROOT=./data/storage

# --- ML & Embeddings ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM Providers (use "mock" offline, "ollama" for free local LLMs, or "deepseek"/"openai"/"anthropic"/"openai_compat") ---
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Optional Job Collectors ---
APIFY_API_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
SERPAPI_API_KEY=

# --- Optional Email Digest ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Observability (Optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexus-ai
